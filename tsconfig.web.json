{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/web-ui/**/*.ts", "src/web-ui/**/*.vue", "src/types/yaml.d.ts"],
  "exclude": ["dist", "node_modules"]
}
